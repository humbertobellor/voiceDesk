# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ — service role key is server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OAuth token encryption (Phase 4 calendar tokens). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=replace-with-64-character-hex-string

# App base URL — used to register the Retell webhook URL on each agent during provisioning.
# Must be the public Vercel URL (no trailing slash). Example: https://voicedesk.vercel.app
# For local testing use an ngrok tunnel URL: https://xxxx.ngrok-free.app
APP_URL=https://your-app.vercel.app

# Retell AI (Phase 2 Provisioning)
RETELL_API_KEY=your-retell-api-key-here

# OpenAI — Phase 3 intent classification (GPT-4o-mini + GPT-4o)
# NEVER prefix with NEXT_PUBLIC_ — this key must never reach the browser
# Source: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Calendar OAuth (Phase 4 scheduling)
# NEVER prefix with NEXT_PUBLIC_ — these are server-only secrets
# Source: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# IMPORTANT — Restricted scope notice (CASA Tier 2): The `calendar.events` scope used in
# Phase 4 is a restricted Google API scope. Before any beta contractor connects their
# Google Calendar, the OAuth app must (1) be moved to Production mode and (2) complete
# a CASA Tier 2 security assessment (estimated 3-8 weeks). Complete this before Phase 4 ships.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match the Authorized redirect URI configured in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
