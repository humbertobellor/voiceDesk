# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: NEVER prefix with NEXT_PUBLIC_ — service role key is server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OAuth token encryption (Phase 4 calendar tokens). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=replace-with-64-character-hex-string

# App base URL — used to register the Retell webhook URL on each agent during provisioning.
# Must be the public Vercel URL (no trailing slash). Example: https://voicedesk.vercel.app
# For local testing use an ngrok tunnel URL: https://xxxx.ngrok-free.app
APP_URL=https://your-app.vercel.app

# Retell AI (Phase 2 Provisioning)
RETELL_API_KEY=your-retell-api-key-here
# Retell webhook signing key — used to verify HMAC-SHA256 signatures on incoming webhooks.
# Source: Retell Dashboard → API Keys → the key with a "webhook" badge next to it.
# May be the same value as RETELL_API_KEY. Without this, the webhook handler returns 500.
# NEVER prefix with NEXT_PUBLIC_ — server-only
RETELL_WEBHOOK_KEY=your-retell-webhook-key-here

# OpenAI — Phase 3 intent classification (GPT-4o-mini + GPT-4o)
# NEVER prefix with NEXT_PUBLIC_ — this key must never reach the browser
# Source: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Calendar OAuth (Phase 4 scheduling)
# NEVER prefix with NEXT_PUBLIC_ — these are server-only secrets
# Source: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# IMPORTANT — Restricted scope notice (CASA Tier 2): The `calendar.events` scope used in
# Phase 4 is a restricted Google API scope. Before any beta contractor connects their
# Google Calendar, the OAuth app must (1) be moved to Production mode and (2) complete
# a CASA Tier 2 security assessment (estimated 3-8 weeks). Complete this before Phase 4 ships.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match the Authorized redirect URI configured in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# Twilio SMS + WhatsApp (Phase 5 Notifications)
# NEVER prefix with NEXT_PUBLIC_ — these are server-only secrets
# Source: Twilio Console → Account Info panel
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# WhatsApp sender number (WABA-approved). Format: whatsapp:+1XXXXXXXXXX
# Source: Twilio Console → Messaging → Senders → WhatsApp Senders
# CRITICAL: WABA registration + template approval (voicedesk_new_lead, voicedesk_emergency)
# takes 3-7 business days. Submit in week 1 of build — do not wait until Phase 5.
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# WhatsApp Content SIDs for approved WABA templates (Phase 5 / Phase 7).
# Source: Twilio Console → Messaging → Content Template Builder → template detail page (HX... value)
# Set after WABA approval. Template names: voicedesk_new_lead, voicedesk_emergency, voicedesk_payment_failed.
# NEVER prefix with NEXT_PUBLIC_ — server-only
TWILIO_WHATSAPP_SID_NEW_LEAD=HXyour-new-lead-content-sid
TWILIO_WHATSAPP_SID_EMERGENCY=HXyour-emergency-content-sid

# Twilio phone number for outbound SMS (E.164 format: +1XXXXXXXXXX)
# Source: Twilio Console → Phone Numbers → Manage → Active Numbers
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Telegram Bot Token (Phase 5 Notifications)
# NEVER prefix with NEXT_PUBLIC_ — server-only secret
# Source: Telegram → @BotFather → /newbot → set username to VoiceDeskBot → copy token
# After first deploy: POST https://api.telegram.org/bot<TOKEN>/setWebhook?url=<APP_URL>/api/webhooks/telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Random secret for Telegram webhook validation (T-05-04-01 — prevents unauthorized POST to /api/webhooks/telegram)
# Generate with: openssl rand -hex 32
# Pass to setWebhook: POST https://api.telegram.org/bot<TOKEN>/setWebhook with secret_token=<this value>
TELEGRAM_WEBHOOK_SECRET=your-random-hex-secret

# Stripe (Phase 7 - Billing & Onboarding)
# NEVER prefix with NEXT_PUBLIC_ — server-only secrets
# Source: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Source: Stripe Dashboard → Developers → Webhooks → Add endpoint → Copy signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Source: Stripe Dashboard → Products → Basic ($299/mo) → Copy price ID
STRIPE_BASIC_PLAN_ID=price_...
# Source: Stripe Dashboard → Products → Professional ($499/mo) → Copy price ID
STRIPE_PROFESSIONAL_PLAN_ID=price_...
# Source: Stripe Dashboard → Products → Enterprise ($799/mo) → Copy price ID
STRIPE_ENTERPRISE_PLAN_ID=price_...

# Inngest (background jobs — Phase 2 onwards)
# Source: Inngest Dashboard → Settings → Event Keys + Signing Keys
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
